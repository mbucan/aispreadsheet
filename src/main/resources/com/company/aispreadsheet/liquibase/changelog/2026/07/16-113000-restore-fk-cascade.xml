<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="com/company/aispreadsheet/liquibase/changelog/2026/07/16-113000-restore-fk-cascade.xml">

    <!-- Restores ON DELETE CASCADE on the report->characteristic FK.
         Reports and their characteristics are hard-deleted (no soft-delete traits),
         so the composition cascade must be enforced by the database FK (see
         030-measurement.xml changeset 6). The Studio-generated changelog
         2026/07/15-165348-c581d956.xml recreated the constraint without the
         cascade, which breaks deletion of any report that has characteristics. -->
    <changeSet id="1" author="aispreadsheet">
        <dropForeignKeyConstraint baseTableName="AIS_MEASUREMENT_CHARACTERISTIC"
                                  constraintName="FK_AIS_MEASUREMENT_CHARACTERISTIC_ON_REPORT"/>
    </changeSet>
    <changeSet id="2" author="aispreadsheet">
        <addForeignKeyConstraint baseTableName="AIS_MEASUREMENT_CHARACTERISTIC" baseColumnNames="REPORT_ID"
                                 referencedTableName="AIS_MEASUREMENT_REPORT" referencedColumnNames="ID"
                                 constraintName="FK_AIS_MEASUREMENT_CHARACTERISTIC_ON_REPORT"
                                 onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
